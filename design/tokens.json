{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Cyclops Design System",
    "version": "1.0.0",
    "product": "Cyclops",
    "mood": "mineral: limestone dust, weathered slate, oxidized copper",
    "notes": "Visual language independent of efe-design. Structural laws only: 4px spacing, a11y floors, flat elevation, triple-encoded semantics. Figma MCP unavailable this session. Paper + this JSON are canonical until Figma sync."
  },
  "a11y": {
    "floors": { "informational_text": "4.5:1", "large_text": "3:1", "functional_nontext": "3:1" },
    "rules": [
      "Structure and state read in greyscale",
      "Focus ring 2px solid accent, 2px offset",
      "prefers-reduced-motion disables non-essential motion",
      "Touch targets >= 44px on coarse pointers"
    ]
  },
  "color": {
    "primitive": {
      "white": "#FFFFFF",
      "slate": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617"
      },
      "teal": {
        "50": "#F0FDFA",
        "100": "#CCFBF1",
        "200": "#99F6E4",
        "500": "#14B8A6",
        "600": "#0D9488",
        "700": "#0F766E",
        "800": "#115E59"
      },
      "danger": { "fg": "#A5341E", "tint": "#FCEBE7" },
      "success": { "fg": "#2F6340", "tint": "#E6F4EA" },
      "attention": { "fg": "#7A5416", "tint": "#F8F0DE" }
    },
    "semantic": {
      "light": {
        "canvas": "#F8FAFC",
        "surface-1": "#FFFFFF",
        "surface-2": "#F1F5F9",
        "surface-3": "#E2E8F0",
        "text-strong": "#0F172A",
        "text-muted": "#475569",
        "text-faint": "#64748B",
        "border": "#94A3B8",
        "seam": "#E2E8F0",
        "accent": "#0F766E",
        "accent-hover": "#115E59",
        "accent-soft": "#F0FDFA",
        "accent-on": "#FFFFFF",
        "focus": "#0F766E",
        "scrim": "rgba(15,23,42,0.40)",
        "danger-fg": "#A5341E",
        "danger-tint": "#FCEBE7",
        "success-fg": "#2F6340",
        "success-tint": "#E6F4EA",
        "attention-fg": "#7A5416",
        "attention-tint": "#F8F0DE"
      },
      "dark": {
        "canvas": "#0F172A",
        "surface-1": "#1E293B",
        "surface-2": "#334155",
        "surface-3": "#475569",
        "text-strong": "#F8FAFC",
        "text-muted": "#CBD5E1",
        "text-faint": "#94A3B8",
        "border": "rgba(248,250,252,0.28)",
        "seam": "rgba(248,250,252,0.09)",
        "accent": "#14B8A6",
        "accent-hover": "#2DD4BF",
        "accent-soft": "rgba(20,184,166,0.14)",
        "accent-on": "#0F172A",
        "focus": "#2DD4BF",
        "scrim": "rgba(2,6,23,0.60)",
        "danger-fg": "#E8836B",
        "danger-tint": "rgba(232,131,107,0.14)",
        "success-fg": "#6FBF86",
        "success-tint": "rgba(111,191,134,0.14)",
        "attention-fg": "#D8A552",
        "attention-tint": "rgba(216,165,82,0.14)"
      }
    }
  },
  "type": {
    "families": {
      "sans": "IBM Plex Sans",
      "mono": "IBM Plex Mono"
    },
    "scale": {
      "display": { "size": "28px", "weight": 600, "line": "34px", "tracking": "-0.02em" },
      "title": { "size": "22px", "weight": 600, "line": "28px", "tracking": "-0.015em" },
      "heading": { "size": "16px", "weight": 600, "line": "22px", "tracking": "-0.01em" },
      "body": { "size": "15px", "weight": 400, "line": "24px" },
      "label": { "size": "14px", "weight": 500, "line": "20px" },
      "meta": { "size": "13px", "weight": 400, "line": "18px" },
      "caption": { "size": "12px", "weight": 500, "line": "16px", "tracking": "0.04em", "case": "uppercase" },
      "code": { "size": "13px", "weight": 400, "line": "20px", "family": "mono" }
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "grouping": "within 8px; between 24–40px"
  },
  "radius": { "sm": "4px", "md": "6px", "lg": "8px", "xl": "12px", "full": "999px" },
  "elevation": {
    "flat": "none",
    "popover": "0 1px 2px rgba(15,23,42,0.04), 0 8px 24px rgba(15,23,42,0.08)",
    "modal": "0 4px 16px rgba(15,23,42,0.10), 0 24px 60px rgba(15,23,42,0.14)"
  },
  "motion": {
    "duration": { "micro": "160ms", "overlay": "240ms" },
    "easing": { "smooth": "cubic-bezier(0.32, 0.72, 0, 1)" },
    "reduced": "honor prefers-reduced-motion"
  },
  "layout": {
    "sidebar": "240px",
    "content-read": "720px",
    "content-data": "1120px",
    "breakpoints": { "sm": "768px", "md": "1024px", "lg": "1280px" }
  },
  "componentTokens": {
    "button-height": "36px",
    "input-height": "40px",
    "row-height": "44px",
    "icon": { "sm": "14px", "md": "16px", "lg": "20px" }
  },
  "research": {
    "mobbin": [
      "https://mobbin.com/screens/fd1b4d88-f021-49a3-98af-4cd3a87e1d29",
      "https://mobbin.com/screens/fc7b35c9-f823-4f28-bb16-d981a05cb530",
      "https://mobbin.com/screens/f3666f12-7fa0-4123-b070-f5641a9eeff7",
      "https://mobbin.com/screens/f187fa83-44e8-4edb-bcb5-1c49f24cae9f"
    ]
  }
}
